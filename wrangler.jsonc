{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "byoa",
	"main": "relay/index.ts",
	"workers_dev": false,
	"dev": { "port": 8790 },
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["enable_request_signal"],
	"rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
	"durable_objects": {
		"bindings": [{ "name": "SESSION", "class_name": "Session" }]
	},
	"r2_buckets": [{ "binding": "PAYLOADS", "bucket_name": "byoa-payloads" }],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }]
}
